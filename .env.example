NODE_ENV=production
PORT=8080
TRUST_PROXY=1
DATABASE_URL=postgresql://kitsune:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/kitsune
DATABASE_SSL=0
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
SESSION_DAYS=30
ALLOWED_ORIGINS=
DB_POOL_SIZE=20
TURN_URLS=turn:your-domain.example:3478,turns:your-domain.example:5349
TURN_USERNAME=REPLACE_WITH_TURN_USERNAME
TURN_CREDENTIAL=REPLACE_WITH_TURN_CREDENTIAL
